void setLEDs(SystemState s) {
  digitalWrite(LED_GREEN,  (s == STATE_NORMAL)   ? HIGH : LOW);
  digitalWrite(LED_YELLOW, (s == STATE_INSECT)   ? HIGH : LOW);
  digitalWrite(LED_RED,    (s == STATE_EXTERNAL) ? HIGH : LOW);
}

void updateBuzzer() {
  uint32_t now = millis();

  if (currentState == STATE_NORMAL || alarmMuted) {
    digitalWrite(BUZZER_PIN, LOW);
    buzzerPinState = false;
    return;
  }

  uint32_t onTimeMs;
  uint32_t offTimeMs;

  if (currentState == STATE_INSECT) {
    // Clearly audible repeating alarm for infestation.
    onTimeMs = 300;
    offTimeMs = 250;
  } else {
    // Faster pulse for external disturbance.
    onTimeMs = 140;
    offTimeMs = 140;
  }

  if (now >= buzzerNextToggleMs) {
    buzzerPinState = !buzzerPinState;
    digitalWrite(BUZZER_PIN, buzzerPinState ? HIGH : LOW);
    buzzerNextToggleMs =
        now + (buzzerPinState ? onTimeMs : offTimeMs);
  }
}

void handleButton() {
  static bool lastBtnState = HIGH;
  bool nowState = digitalRead(BUTTON_PIN);
  uint32_t now = millis();

  if (lastBtnState == HIGH &&
      nowState == LOW &&
      (now - lastButtonPressMs > 250UL)) {

    lastButtonPressMs = now;

    if (currentState == STATE_INSECT ||
        currentState == STATE_EXTERNAL ||
        insectLatched) {

      // Acknowledge current alarm and reset detection history.
      currentState = STATE_NORMAL;
      insectLatched = false;
      insectConfirmCount = 0;
      externalHoldUntil = 0;
      alarmMuted = false;

      memset(insectHistory, 0, sizeof(insectHistory));
      historyIndex = 0;
      recentInsectVotes = 0;

      digitalWrite(BUZZER_PIN, LOW);
      buzzerPinState = false;

      Serial.println(F("[BUTTON] Alarm acknowledged and reset."));
    } else {
      alarmMuted = !alarmMuted;
      Serial.print(F("[BUTTON] Alarm mute: "));
      Serial.println(alarmMuted ? F("ON") : F("OFF"));
    }
  }

  lastBtnState = nowState;
}

void startupSelfTest() {
  Serial.println(F("--- STARTUP HARDWARE SELF-TEST ---"));

  digitalWrite(BUZZER_PIN, LOW);

  const uint8_t testPins[3] = {
    LED_GREEN, LED_YELLOW, LED_RED
  };

  for (uint8_t i = 0; i < 3; i++) {
    digitalWrite(testPins[i], HIGH);

    // Two-stage pulse makes the buzzer easy to hear and verify.
    digitalWrite(BUZZER_PIN, HIGH);
    delay(120);
    digitalWrite(BUZZER_PIN, LOW);
    delay(80);

    digitalWrite(testPins[i], LOW);
  }

  digitalWrite(BUZZER_PIN, HIGH);
  delay(120);
  digitalWrite(BUZZER_PIN, LOW);

  digitalWrite(LED_GREEN, HIGH);

  buzzerPinState = false;
  buzzerNextToggleMs = millis() + 100UL;

  Serial.println(F("Self-test complete."));
}

// ========================================================================================
// FAST IN-PLACE RADIX-2 COOLEY-TUKEY FFT
// ========================================================================================
void computeFFT(float *re, float *im, int n) {
  int j = 0;
  for (int i = 0; i < n - 1; i++) {
    if (i < j) {
      float tRe = re[i]; re[i] = re[j]; re[j] = tRe;
      float tIm = im[i]; im[i] = im[j]; im[j] = tIm;
    }
    int k = n >> 1;
    while (k <= j) {
      j -= k;
      k >>= 1;
    }
    j += k;
  }

  for (int len = 2; len <= n; len <<= 1) {
    float ang = -2.0f * 3.14159265358979323846f / (float)len;
    float wRe = cosf(ang);
    float wIm = sinf(ang);
    int half = len >> 1;
    for (int i = 0; i < n; i += len) {
      float curRe = 1.0f;
      float curIm = 0.0f;
      for (int k = 0; k < half; k++) {
        int idx1 = i + k;
        int idx2 = i + k + half;
        float tRe = re[idx2] * curRe - im[idx2] * curIm;
        float tIm = re[idx2] * curIm + im[idx2] * curRe;
        re[idx2] = re[idx1] - tRe;
        im[idx2] = im[idx1] - tIm;
        re[idx1] += tRe;
        im[idx1] += tIm;
        float nextRe = curRe * wRe - curIm * wIm;
        float nextIm = curRe * wIm + curIm * wRe;
        curRe = nextRe;
        curIm = nextIm;
      }
    }
  }
}

// Synchronous interleaved sampling across P1, P2, and MIC
void acquireWindow(int16_t *outP1, int16_t *outP2, int16_t *outMic, float &actualFs) {
  uint32_t t0 = micros();

  for (uint16_t i = 0; i < WINDOW_SIZE; i++) {
    outP1[i]  = (int16_t)analogRead(P1_PIN);
    outP2[i]  = (int16_t)analogRead(P2_PIN);
    outMic[i] = (int16_t)analogRead(MIC_PIN);

    // Keep buzzer and button actively serviced during ADC sampling
    if ((i & 0x0F) == 0) {
      updateBuzzer();
      handleButton();
    }
  }

  uint32_t t1 = micros();
  uint32_t elapsed = t1 - t0;
  if (elapsed < 1000) elapsed = 1000;
  actualFs = (float)WINDOW_SIZE * 1000000.0f / (float)elapsed;
}


// ========================================================================================
// FEATURE EXTRACTION (TIME-DOMAIN + SPECTRAL + BURST SEGMENTATION)
// ========================================================================================
void extractChannelFeatures(const int16_t *raw, float &baseline, float noiseFloor,
                             float binWidthHz, ChannelFeatures &feat) {
  // First find the actual DC level in THIS window.
  // This makes the detector respond quickly if the container/probe orientation
  // or mechanical loading changes suddenly.
  double rawSum = 0.0;

  for (uint16_t i = 0; i < WINDOW_SIZE; ++i) {
    rawSum += (double)raw[i];
  }

  float windowMean = (float)(rawSum / (double)WINDOW_SIZE);
  float dcShift = fabsf(windowMean - baseline);

  double sumDevSq = 0.0;
  double sumDev = 0.0;
  float maxDev = 0.0f;

  const float eventThreshold =
      (noiseFloor * 2.4f > 5.0f) ? (noiseFloor * 2.4f) : 5.0f;
  const float releaseThreshold = eventThreshold * 0.55f;

  bool inEvent = false;
  uint16_t eventCount = 0;
  uint16_t eventTotalSamples = 0;
  uint16_t quietGapSamples = 0;
  uint16_t gapSumSamples = 0;
  uint16_t gapCount = 0;

  for (uint16_t i = 0; i < WINDOW_SIZE; ++i) {
    float dev = fabsf((float)raw[i] - windowMean);

    sumDev += dev;
    sumDevSq += (double)dev * (double)dev;

    if (dev > maxDev) maxDev = dev;

    // Count separated bursts, not every sample above threshold.
    if (!inEvent) {
      if (dev >= eventThreshold) {
        inEvent = true;
        eventCount++;
        quietGapSamples = 0;
      }
    } else {
      if (dev < releaseThreshold) {
        quietGapSamples++;
        if (quietGapSamples >= 3) {
          inEvent = false;
          gapCount++;
          gapSumSamples += quietGapSamples;
          quietGapSamples = 0;
        }
      } else {
        quietGapSamples = 0;
        eventTotalSamples++;
      }
    }

    fftRe[i] = ((float)raw[i] - windowMean) * hannWindow[i];
    fftIm[i] = 0.0f;
  }

  feat.mean = windowMean;
  feat.rms = sqrtf((float)(sumDevSq / (double)WINDOW_SIZE));
  feat.peak = maxDev;
  feat.crest = feat.peak / (feat.rms + EPS);
  feat.activity = feat.rms / (noiseFloor + EPS);

  feat.events = eventCount;
  feat.eventDuration =
      (eventCount > 0) ?
      ((float)eventTotalSamples / (float)eventCount) : 0.0f;
  feat.eventInterval =
      (gapCount > 0) ?
      ((float)gapSumSamples / (float)gapCount) : 0.0f;

  // Fast baseline adaptation for a genuine DC shift, slow adaptation during
  // vibration so actual events are not absorbed immediately.
  if (feat.rms < noiseFloor * 2.0f + 3.0f) {
    if (dcShift > 20.0f) {
      baseline = baseline * 0.50f + windowMean * 0.50f;
    } else {
      baseline = baseline * 0.95f + windowMean * 0.05f;
    }
  } else {
    baseline = baseline * 0.995f + windowMean * 0.005f;
  }

  computeFFT(fftRe, fftIm, FFT_SIZE);

  float totalEnergy = 0.0f;
  float maxMag = 0.0f;
  int maxBin = 1;
  float numCentroid = 0.0f;
  float denCentroid = 0.0f;

  float energyLow = 0.0f;
  float energyMid = 0.0f;
  float energyHigh = 0.0f;

  for (int k = 1; k <= (int)FFT_HALF; ++k) {
    float mag = sqrtf(fftRe[k] * fftRe[k] + fftIm[k] * fftIm[k]);
    fftMag[k] = mag;

    float power = mag * mag;
    totalEnergy += power;

    if (mag > maxMag) {
      maxMag = mag;
      maxBin = k;
    }

    float freqHz = (float)k * binWidthHz;
    numCentroid += freqHz * mag;
    denCentroid += mag;

    if (k <= 15) {
      energyLow += power;
    } else if (k <= 35) {
      energyMid += power;
    } else {
      energyHigh += power;
    }
  }

  feat.specEnergy = totalEnergy;
  feat.dominantFreq = (float)maxBin * binWidthHz;
  feat.centroid = numCentroid / (denCentroid + EPS);

  float numSpread = 0.0f;
  for (int k = 1; k <= (int)FFT_HALF; ++k) {
    float freqHz = (float)k * binWidthHz;
    float diff = freqHz - feat.centroid;
    numSpread += (diff * diff) * fftMag[k];
  }

  feat.spread = sqrtf(numSpread / (denCentroid + EPS));
  feat.bandLow = energyLow;
  feat.bandMid = energyMid;
  feat.bandHigh = energyHigh;
}

// ========================================================================================
// SENSOR BASELINE AND NOISE FLOOR CALIBRATION
// ========================================================================================
void calibrateSystem() {
  Serial.println(F("CALIBRATING SENSORS: keep container completely still & quiet..."));

  oledClear();
  oledText(0, 0,  "GRAIN MONITOR");
  oledText(0, 16, "CALIBRATING...");
  oledText(0, 32, "KEEP STILL & QUIET");
  oledText(0, 48, "CDAC VEGA V2");
  oledShow();

  double sumP1 = 0.0;
  double sumP2 = 0.0;
  double sumMic = 0.0;

  for (uint16_t i = 0; i < CAL_SAMPLES; i++) {
    sumP1  += (double)analogRead(P1_PIN);
    sumP2  += (double)analogRead(P2_PIN);
    sumMic += (double)analogRead(MIC_PIN);
    delay(4);
  }

  baseP1  = (float)(sumP1  / (double)CAL_SAMPLES);
  baseP2  = (float)(sumP2  / (double)CAL_SAMPLES);
  baseMic = (float)(sumMic / (double)CAL_SAMPLES);

  double sumSqP1 = 0.0;
  double sumSqP2 = 0.0;
  double sumSqMic = 0.0;

  for (uint16_t i = 0; i < CAL_SAMPLES; i++) {
    float d1 = (float)analogRead(P1_PIN)  - baseP1;
    float d2 = (float)analogRead(P2_PIN)  - baseP2;
    float dm = (float)analogRead(MIC_PIN) - baseMic;
    sumSqP1  += (double)d1 * (double)d1;
    sumSqP2  += (double)d2 * (double)d2;
    sumSqMic += (double)dm * (double)dm;
    delay(4);
  }

  noiseFloorP1  = sqrtf((float)(sumSqP1  / (double)CAL_SAMPLES));
  noiseFloorP2  = sqrtf((float)(sumSqP2  / (double)CAL_SAMPLES));
  noiseFloorMic = sqrtf((float)(sumSqMic / (double)CAL_SAMPLES));

  if (noiseFloorP1  < 2.0f) noiseFloorP1  = 2.0f;
  if (noiseFloorP2  < 2.0f) noiseFloorP2  = 2.0f;
  if (noiseFloorMic < 2.0f) noiseFloorMic = 2.0f;

  quietEnergyP1  = (noiseFloorP1 * noiseFloorP1) * (float)WINDOW_SIZE * 0.4f;
  quietEnergyP2  = (noiseFloorP2 * noiseFloorP2) * (float)WINDOW_SIZE * 0.4f;
  quietEnergyMic = (noiseFloorMic * noiseFloorMic) * (float)WINDOW_SIZE * 0.4f;

  Serial.println(F("--- CALIBRATION RESULTS ---"));
  Serial.print(F("Baseline: P1="));  Serial.print(baseP1, 1);
  Serial.print(F(" P2="));           Serial.print(baseP2, 1);
  Serial.print(F(" MIC="));          Serial.println(baseMic, 1);
  Serial.print(F("NoiseRMS: P1="));  Serial.print(noiseFloorP1, 2);
  Serial.print(F(" P2="));           Serial.print(noiseFloorP2, 2);
  Serial.print(F(" MIC="));          Serial.println(noiseFloorMic, 2);
}

// ========================================================================================
// SCORING ENGINE & DECISION LOGIC
// ========================================================================================

// Convert a score to a bounded confidence percentage.
float clampPercent(float x) {
  if (x < 0.0f) return 0.0f;
  if (x > 100.0f) return 100.0f;
  return x;
}

// A "burst" is deliberately separated by a quiet gap in extractChannelFeatures().
// This prevents one container tap/ring-down from becoming dozens of events.
void evaluateScores(const ChannelFeatures &f1, const ChannelFeatures &f2,
                    const ChannelFeatures &fm, ScoreBreakdown &sc) {
  const float p1Activity = f1.activity;
  const float p2Activity = f2.activity;
  const float micActivity = fm.activity;

  const float p1PeakNorm = f1.peak / (noiseFloorP1 + EPS);
  const float p2PeakNorm = f2.peak / (noiseFloorP2 + EPS);
  const float micPeakNorm = fm.peak / (noiseFloorMic + EPS);

  const float strongestProbeActivity =
      (p1Activity > p2Activity) ? p1Activity : p2Activity;

  const float weakestProbeActivity =
      (p1Activity < p2Activity) ? p1Activity : p2Activity;

  sc.spatialImbalance =
      fabsf(f1.rms - f2.rms) / (f1.rms + f2.rms + 1.0f);

  sc.probeRatio = (f1.rms + EPS) / (f2.rms + EPS);
  sc.ambientDominance =
      micActivity / (strongestProbeActivity + 0.25f);

  // Activity threshold is RELATIVE to each channel's own calibrated floor.
  // No fixed 0.7 V / fixed lower-probe threshold is used.
  bool p1Active = (p1Activity >= 2.0f) || (p1PeakNorm >= 2.8f);
  bool p2Active = (p2Activity >= 2.0f) || (p2PeakNorm >= 2.8f);
  bool micActive = (micActivity >= 2.3f) || (micPeakNorm >= 3.0f);

  bool oneProbeActive = p1Active || p2Active;
  bool bothProbesActive = p1Active && p2Active;

  // --------------------------------------------------------------------------
  // INSECT EVIDENCE
  // --------------------------------------------------------------------------
  sc.temporal = 0.0f;
  sc.spatial = 0.0f;
  sc.spectral = 0.0f;
  sc.ambientRejection = 0.0f;
  sc.recurrence = 0.0f;

  if (oneProbeActive) {
    // Repeated separated bursts are strong evidence.
    uint16_t events = (f1.events > f2.events) ? f1.events : f2.events;
    if (events >= 1) sc.temporal += 8.0f;
    if (events >= 2) sc.temporal += 10.0f;
    if (events >= 3) sc.temporal += 12.0f;

    // Reasonable event duration for small internal mechanical events.
    float dur = (f1.events >= f2.events) ? f1.eventDuration : f2.eventDuration;
    if (dur >= 1.0f && dur <= 18.0f) sc.temporal += 8.0f;

    // Localized activity is important: do NOT require both probes to be active.
    if (sc.spatialImbalance >= 0.12f) {
      sc.spatial += 10.0f;
    }
    if (sc.spatialImbalance >= 0.25f) {
      sc.spatial += 12.0f;
    }
    if (strongestProbeActivity > weakestProbeActivity * 1.35f) {
      sc.spatial += 8.0f;
    }

    // Probe signal should dominate the ambient reference.
    if (sc.ambientDominance < 1.0f) sc.ambientRejection += 8.0f;
    if (sc.ambientDominance < 0.75f) sc.ambientRejection += 10.0f;
    if (sc.ambientDominance < 0.55f) sc.ambientRejection += 8.0f;

    // Spectral evidence is used as a supporting feature, not a single-frequency rule.
    float highVsLow = (f1.bandHigh + f2.bandHigh + EPS) /
                      (f1.bandLow + f2.bandLow + EPS);

    if (highVsLow > 0.15f) sc.spectral += 6.0f;
    if (f1.spread > 5.0f || f2.spread > 5.0f) sc.spectral += 5.0f;
    if (f1.centroid > 10.0f || f2.centroid > 10.0f) sc.spectral += 4.0f;

    // History is evaluated from previous decisions and then updated below.
    sc.recurrence = ((float)recentInsectVotes / (float)HISTORY_LEN) * 25.0f;
  }

  sc.totalInsect =
      sc.temporal +
      sc.spatial +
      sc.spectral +
      sc.ambientRejection +
      sc.recurrence;

  // Strong simultaneous dual-probe + microphone impulses are specifically
  // treated as external events, and are penalized as insect candidates.
  if (bothProbesActive && micActive) {
    sc.totalInsect -= 20.0f;
  }

  if (sc.totalInsect < 0.0f) sc.totalInsect = 0.0f;
  if (sc.totalInsect > 100.0f) sc.totalInsect = 100.0f;

  // --------------------------------------------------------------------------
  // EXTERNAL DISTURBANCE EVIDENCE
  // --------------------------------------------------------------------------
  sc.impulse = 0.0f;
  sc.simultaneousProbe = 0.0f;
  sc.microphone = 0.0f;

  float highestPeakNorm =
      (p1PeakNorm > p2PeakNorm) ? p1PeakNorm : p2PeakNorm;

  float highestCrest =
      (f1.crest > f2.crest) ? f1.crest : f2.crest;

  // Large short impulses are external candidates.
  if (highestPeakNorm >= 5.0f) sc.impulse += 18.0f;
  if (highestPeakNorm >= 8.0f) sc.impulse += 12.0f;
  if (highestCrest >= 4.0f) sc.impulse += 8.0f;

  // Similar response on both probes is a key touch/knock signature.
  if (bothProbesActive) {
    sc.simultaneousProbe += 25.0f;
    if (sc.spatialImbalance < 0.25f) sc.simultaneousProbe += 20.0f;
    if (sc.spatialImbalance < 0.12f) sc.simultaneousProbe += 10.0f;
  }

  // Microphone corroborates an environmental/container event.
  if (micActive) {
    sc.microphone += 20.0f;
    if (micActivity >= 4.0f) sc.microphone += 8.0f;
  }

  // Repeated internal events make an external classification less likely.
  float recurrencePenalty =
      ((float)recentInsectVotes / (float)HISTORY_LEN) * 20.0f;

  sc.totalExternal =
      sc.impulse +
      sc.simultaneousProbe +
      sc.microphone -
      recurrencePenalty;

  // A microphone-only event is never external.
  if (!oneProbeActive) {
    sc.totalExternal = 0.0f;
  }

  if (sc.totalExternal < 0.0f) sc.totalExternal = 0.0f;
  if (sc.totalExternal > 100.0f) sc.totalExternal = 100.0f;
}

float getCurrentConfidence() {
  if (currentState == STATE_INSECT) {
    return clampPercent(scores.totalInsect);
  }
  if (currentState == STATE_EXTERNAL) {
    return clampPercent(scores.totalExternal);
  }

  float quiet = 100.0f - max(scores.totalInsect, scores.totalExternal);
  return clampPercent(quiet);
}

void updateStateMachine(const ScoreBreakdown &sc) {
  uint32_t now = millis();

  // External events have priority and are held briefly so the jury can see them.
  bool externalCandidate =
      (sc.totalExternal >= 55.0f) &&
      (sc.impulse >= 15.0f) &&
      (sc.simultaneousProbe >= 25.0f);

  if (externalCandidate) {
    currentState = STATE_EXTERNAL;
    externalHoldUntil = now + EXTERNAL_HOLD_MS;

    // Clear current insect confirmation, but keep the history for analysis.
    insectConfirmCount = 0;
    insectLatched = false;
    return;
  }

  if (now < externalHoldUntil) {
    currentState = STATE_EXTERNAL;
    return;
  }

  // Current-window insect candidate.
  // Require a meaningful score AND at least one actual probe burst.
  bool insectCandidate =
      (sc.totalInsect >= 48.0f) &&
      ((featP1.events >= 1) || (featP2.events >= 1));

  // Update history.
  insectHistory[historyIndex] = insectCandidate ? 1 : 0;
  historyIndex = (uint8_t)((historyIndex + 1U) % HISTORY_LEN);

  recentInsectVotes = 0;
  for (uint8_t i = 0; i < HISTORY_LEN; i++) {
    recentInsectVotes += insectHistory[i];
  }

  if (insectCandidate) {
    if (insectConfirmCount < 10) insectConfirmCount++;
  } else if (insectConfirmCount > 0) {
    insectConfirmCount--;
  }

  // Insect detection requires recurrence, not one isolated hit.
  // Either:
  //   - 3 consecutive supporting windows, OR
  //   - 4 of the last 8 windows are supporting.
  if ((insectConfirmCount >= 3) || (recentInsectVotes >= 4)) {
    insectLatched = true;
    currentState = STATE_INSECT;
    return;
  }

  // Once insect activity is identified, keep it visible until the button is
  // pressed, so the jury does not miss a short detection.
  if (insectLatched) {
    currentState = STATE_INSECT;
    return;
  }

  currentState = STATE_NORMAL;
}

