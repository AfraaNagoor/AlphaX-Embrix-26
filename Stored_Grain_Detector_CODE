void oledCommand(uint8_t c) {
  Wire.beginTransmission(OLED_ADDR);
  Wire.write(0x00);
  Wire.write(c);
  Wire.endTransmission();
}

void oledInit() {
  Wire.begin();
  delay(30);

  const uint8_t initCommands[] = {
    0xAE, 0xD5, 0x80, 0xA8, 0x3F, 0xD3, 0x00,
    0x40, 0x8D, 0x14, 0x20, 0x00, 0xA1, 0xC8,
    0xDA, 0x12, 0x81, 0xCF, 0xD9, 0xF1, 0xDB,
    0x40, 0xA4, 0xA6, 0xAF
  };

  for (size_t i = 0; i < sizeof(initCommands); i++) {
    oledCommand(initCommands[i]);
  }

  memset(oledBuffer, 0, sizeof(oledBuffer));
}

void oledClear() {
  memset(oledBuffer, 0, sizeof(oledBuffer));
}

void oledPixel(int x, int y, bool on) {
  if (x < 0 || x >= 128 || y < 0 || y >= 64) return;
  uint16_t idx = x + (y / 8) * 128;
  uint8_t mask = (uint8_t)(1U << (y & 7));
  if (on) oledBuffer[idx] |= mask;
  else    oledBuffer[idx] &= (uint8_t)~mask;
}

void oledChar(int x, int y, char c) {
  if (c < 32 || c > 126) c = ' ';
  uint16_t fontOffset = (uint16_t)(c - 32) * 5;
  for (uint8_t col = 0; col < 5; ++col) {
    uint8_t line = font5x7[fontOffset + col];
    for (uint8_t row = 0; row < 7; ++row) {
      if (line & (1U << row)) {
        oledPixel(x + col, y + row, true);
      }
    }
  }
}

void oledText(int x, int y, const char *str) {
  while (*str && x <= 122) {
    oledChar(x, y, *str++);
    x += 6;
  }
}

void oledInt(int x, int y, long val) {
  char buf[16];
  snprintf(buf, sizeof(buf), "%ld", val);
  oledText(x, y, buf);
}

void oledFloat(int x, int y, float val, int decimals) {
  char buf[24];
  int k = 0;
  if (val < 0.0f) {
    buf[k++] = '-';
    val = -val;
  }
  long whole = (long)val;
  float remainder = val - (float)whole;

  char tmp[16];
  int t = 0;
  if (whole == 0) {
    tmp[t++] = '0';
  } else {
    while (whole > 0 && t < 15) {
      tmp[t++] = (char)('0' + (whole % 10));
      whole /= 10;
    }
  }
  while (t > 0) {
    buf[k++] = tmp[--t];
  }

  if (decimals > 0) {
    buf[k++] = '.';
    for (int d = 0; d < decimals; d++) {
      remainder *= 10.0f;
      int digit = (int)remainder;
      buf[k++] = (char)('0' + digit);
      remainder -= (float)digit;
    }
  }
  buf[k] = '\0';
  oledText(x, y, buf);
}

void oledShow() {
  for (uint8_t page = 0; page < 8; ++page) {
    oledCommand((uint8_t)(0xB0 | page));
    oledCommand(0x00);
    oledCommand(0x10);

    for (uint8_t blk = 0; blk < 16; ++blk) {
      Wire.beginTransmission(OLED_ADDR);
      Wire.write(0x40);
      for (uint8_t b = 0; b < 8; ++b) {
        Wire.write(oledBuffer[page * 128 + blk * 8 + b]);
      }
      Wire.endTransmission();
    }
  }
}


