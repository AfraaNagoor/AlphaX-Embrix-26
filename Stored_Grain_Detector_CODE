// ========================================================================================
// SETUP
// ========================================================================================
void setup() {
  Serial.begin(115200);
  delay(250);

  Serial.println(F("==========================================================="));
  Serial.println(F("Offline Acoustic Detection of Hidden Insect Infestation"));
  Serial.println(F("Platform: ARIES Vega V2.0 (CDAC RISC-V THEJAS)"));
  Serial.println(F("==========================================================="));

  pinMode(LED_GREEN,  OUTPUT);
  pinMode(LED_YELLOW, OUTPUT);
  pinMode(LED_RED,    OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  digitalWrite(LED_GREEN,  LOW);
  digitalWrite(LED_YELLOW, LOW);
  digitalWrite(LED_RED,    LOW);
  digitalWrite(BUZZER_PIN, LOW);

  for (uint16_t i = 0; i < FFT_SIZE; i++) {
    hannWindow[i] = 0.5f - 0.5f * cosf(2.0f * 3.14159265358979323846f * (float)i / (float)(FFT_SIZE - 1));
  }

  memset(insectHistory, 0, sizeof(insectHistory));

  oledInit();
  startupSelfTest();
  calibrateSystem();

  setLEDs(STATE_NORMAL);
  updateOLED();

  Serial.println(F("System initialized and monitoring."));
  Serial.println(F("A0=P1 (Lower) | A1=P2 (Upper) | A2=MIC (Ambient)"));
}

// ========================================================================================
// MAIN LOOP
// ========================================================================================
void loop() {
  windowCounter++;

  handleButton();
  acquireWindow(bufP1, bufP2, bufMic, effectiveSampleRate);

  float binWidthHz = effectiveSampleRate / (float)FFT_SIZE;

  extractChannelFeatures(bufP1,  baseP1,  noiseFloorP1,  binWidthHz, featP1);
  extractChannelFeatures(bufP2,  baseP2,  noiseFloorP2,  binWidthHz, featP2);
  extractChannelFeatures(bufMic, baseMic, noiseFloorMic, binWidthHz, featMic);

  // Slow quiet-only DC baseline tracking.
  // This follows genuine drift without using a fixed voltage threshold.
  if (featP1.rms < noiseFloorP1 * 1.25f) {
    double avg = 0.0;
    for (uint16_t i = 0; i < WINDOW_SIZE; i++) avg += bufP1[i];
    baseP1 = baseP1 * 0.98f +
             ((float)(avg / (double)WINDOW_SIZE)) * 0.02f;
  }

  if (featP2.rms < noiseFloorP2 * 1.25f) {
    double avg = 0.0;
    for (uint16_t i = 0; i < WINDOW_SIZE; i++) avg += bufP2[i];
    baseP2 = baseP2 * 0.98f +
             ((float)(avg / (double)WINDOW_SIZE)) * 0.02f;
  }

  if (featMic.rms < noiseFloorMic * 1.25f) {
    double avg = 0.0;
    for (uint16_t i = 0; i < WINDOW_SIZE; i++) avg += bufMic[i];
    baseMic = baseMic * 0.98f +
              ((float)(avg / (double)WINDOW_SIZE)) * 0.02f;
  }

  evaluateScores(featP1, featP2, featMic, scores);
  updateStateMachine(scores);

  setLEDs(currentState);
  updateBuzzer();

  uint32_t nowMs = millis();
  if (nowMs - lastOLEDUpdateMs >= OLED_UPDATE_MS) {
    lastOLEDUpdateMs = nowMs;
    updateOLED();
  }

  printSerialDiagnostics();
}

